---
- name: Install Syndicate Issuing CA and update trust store
  hosts: k8s
  become: true

  vars:
    local_ca_src: "/home/funmicra/Documents/Projects/cert-automation/pki/certs/intermediate.pem"
    system_ca_dest: "/usr/local/share/ca-certificates/root-ca.pem"

  tasks:
    - name: Copy issuing CA to system CA directory
      ansible.builtin.copy:
        src: "{{ local_ca_src }}"
        dest: "{{ system_ca_dest }}"
        owner: root
        group: root
        mode: "0644"
      notify: Update CA certificates

  handlers:
    - name: Update CA certificates
      ansible.builtin.command: update-ca-certificates
      changed_when: true
